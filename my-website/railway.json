{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicy": {
      "maxRetries": 10
    },
    "healthcheckPath": "/"
  },
  "services": [
    {
      "name": "shivam-solar-frontend",
      "repo": ".",
      "root": "src/",
      "type": "static"
    },
    {
      "name": "shivam-solar-backend",
      "repo": ".",
      "root": "backend-server/",
      "type": "app"
    }
  ]
}